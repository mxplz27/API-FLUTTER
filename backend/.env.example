# Copia este archivo como .env y ajusta los valores.
PORT=3000
NODE_ENV=development

# Local: mongodb://127.0.0.1:27017/gestor_inmobiliario
# Railway: usa la variable MONGO_URL del servicio de MongoDB (${{MongoDB.MONGO_URL}})
MONGODB_URI=mongodb://127.0.0.1:27017/gestor_inmobiliario

# Cadena larga y aleatoria. Obligatoria en producción.
JWT_SECRET=cambia-esta-clave
JWT_EXPIRES_IN=7d

# Orígenes permitidos separados por coma, o * para todos.
CORS_ORIGIN=*

# Opcional: correo para enviar el código de recuperación.
# Sin SMTP el código se imprime en los logs del servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
