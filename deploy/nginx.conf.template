server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;

    # Recursos pesados que no cambian entre despliegues.
    location ~ ^/(assets|canvaskit|icons)/ {
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    # index.html, main.dart.js, service worker, etc.: siempre la última versión.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
